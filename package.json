{
  "name": "pese-ui",
  "version": "0.1.0",
  "description": "Librería de componentes React de PESE: SSR sin estado, SCSS, Tailwind v4 y tema daisyUI opcional.",
  "license": "MIT",
  "author": "Florencia Peña Sepúlveda",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./daisyui.css": "./dist/daisyui.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "test": "tsx --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "build:js": "tsup",
    "build:css": "sass src/styles/index.scss dist/styles.css --no-source-map --style=compressed && node scripts/copy-css.mjs",
    "build": "npm run tokens && npm run build:js && npm run build:css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "sass": "^1.90.0",
    "storybook": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
