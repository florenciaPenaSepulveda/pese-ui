{
  "name": "@pese-cl/ui",
  "version": "1.1.0",
  "description": "Librería de componentes React de PESE: SSR sin estado, SCSS, Tailwind v4 y tema daisyUI opcional.",
  "license": "MIT",
  "author": {
    "name": "Florencia Peña Sepúlveda",
    "url": "https://github.com/florenciaPenaSepulveda"
  },
  "homepage": "https://pese-ui.onrender.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/florenciaPenaSepulveda/pese-ui.git"
  },
  "bugs": {
    "url": "https://github.com/florenciaPenaSepulveda/pese-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "componentes",
    "design-system",
    "ssr",
    "astro",
    "nextjs",
    "scss",
    "tailwindcss",
    "daisyui",
    "accesibilidad",
    "a11y",
    "storybook"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./daisyui.css": "./dist/daisyui.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "test": "tsx --test \"tests/*.test.ts\" \"tests/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "build:js": "tsup",
    "build:css": "sass src/styles/index.scss dist/styles.css --no-source-map --style=compressed && node scripts/copy-css.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "build": "npm run tokens && npm run build:js && npm run build:css && npm run build:fonts",
    "prestorybook": "npm run build:fonts",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build:fonts",
    "build-storybook": "storybook build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.90.0",
    "semantic-release": "^25.0.9",
    "storybook": "^10.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
